{
  "$schema": "https://opencode.ai/config.json",
  // opencode-go and openrouter are built-in providers: no provider block is
  // needed, just `/connect` in the TUI (keys go to ~/.local/share/opencode/auth.json,
  // not here). Switch models per-session with `/models`.
  //
  // Go has a separate 5-hour/weekly/monthly allowance per model, so when one
  // model runs dry, switching to another Go model is still "already paid for".
  // Live list: curl -s https://opencode.ai/inference/go/v1/models | jq -r '.data[].id'
  "model": "opencode-go/kimi-k3",
  // Titles/summaries: spend a cheap model's allowance, not the main one's.
  "small_model": "opencode-go/glm-5.3-flash",
  "provider": {
    "lmstudio2": {
      "name": "lmstudio-mac",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.0.83:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "systemPrompt": "Keep responses to the point. One step at a time."
        }
      }
    }
  }
}
